# Copy to .env and fill in. .env is gitignored. Never commit real values.

# Groq API key (free tier works): https://console.groq.com/keys
GROQ_API_KEY=
# Optional, default is openai/gpt-oss-20b (supports tool calling)
GROQ_MODEL=openai/gpt-oss-20b

# Graftcode Project Key in the form username:token, from
# portal.graftcode.com > Settings > Project keys > Add new key (type Personal).
# Optional: the gateway and MCP endpoint also run without it, locally.
GC_PROJECT_KEY=

# MCP endpoint of the running gateway (HTTP port)
MCP_URL=http://localhost:81/mcp
